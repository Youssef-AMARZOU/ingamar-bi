# INGAMAR BI - Environment Variables
# Copy this file to .env and fill in your values

# Groq AI API key (free at https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here

# Database (defaults to SQLite)
# INGAMAR_DB_URI=postgresql://user:pass@localhost:5432/ingamar

# Flask secret keys
# INGAMAR_SECRET_KEY=change-this
# INGAMAR_JWT_SECRET_KEY=change-this-too
